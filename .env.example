# Future phase configuration. Copy to .env; never commit secrets.
DATABASE_URL=postgres://sochat:sochat_dev_only@localhost:5432/sochat
SESSION_SECRET=replace-with-a-long-random-local-secret
LLM_PROVIDER=fake
GEMINI_API_KEY=
GEMINI_MODEL=
LLM_DAILY_CAP_PER_USER=50
LLM_DAILY_CAP_GLOBAL=500
# Optional owner-supplied CURRENT pricing, USD per million tokens, evaluation only.
# Blank values report cost as unknown for real Gemini; never assume a free tier.
LLM_INPUT_USD_PER_MILLION=
LLM_OUTPUT_USD_PER_MILLION=
# API defaults; keep loopback for local development.
APP_ORIGIN=http://localhost:5173
PORT=3000
TRUST_PROXY_HOPS=0
