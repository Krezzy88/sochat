{
  "name": "sochat",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.13.0 <23",
    "npm": ">=10 <11"
  },
  "packageManager": "npm@10.9.4",
  "scripts": {
    "preinstall": "node scripts/check-runtime.mjs",
    "check:runtime": "node scripts/check-runtime.mjs",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "eval": "node --experimental-strip-types eval/run_eval.ts",
    "db:migrate": "node --env-file=.env --experimental-strip-types apps/api/src/db/migrate.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "eval:llm": "node --env-file=.env --experimental-strip-types eval/run_eval.ts --provider gemini"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testcontainers/postgresql": "12.2.1",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.14.0",
    "fast-check": "4.10.2",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  }
}
