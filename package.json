{
  "name": "sochat",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.19.0 <23",
    "npm": ">=10 <11"
  },
  "packageManager": "npm@10.9.4",
  "scripts": {
    "preinstall": "node scripts/check-runtime.mjs",
    "check:runtime": "node scripts/check-runtime.mjs",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config config/testing/vitest.config.ts",
    "test:coverage": "vitest run --config config/testing/vitest.config.ts --coverage",
    "eval": "node --experimental-strip-types eval/run_eval.ts",
    "db:migrate": "node --env-file=.env --experimental-strip-types apps/api/src/db/migrate.ts",
    "test:integration": "vitest run --config config/testing/vitest.integration.config.ts",
    "eval:llm": "node --env-file=.env --experimental-strip-types eval/run_eval.ts --provider gemini",
    "api:start": "node --env-file=.env --experimental-strip-types apps/api/src/server.ts",
    "api:openapi": "node --experimental-strip-types apps/api/src/openapi.ts",
    "web:dev": "npm run dev --workspace @sochat/web",
    "web:build": "npm run build --workspace @sochat/web",
    "web:preview": "npm run preview --workspace @sochat/web",
    "e2e": "node --experimental-strip-types e2e/run.ts",
    "e2e:serve": "node --experimental-strip-types e2e/server.ts",
    "web:audit": "node --experimental-strip-types e2e/audit.ts",
    "check:gemini:live": "node --env-file=.env --experimental-strip-types scripts/check-gemini-live.ts",
    "test:gemini:ui": "playwright test --config config/testing/playwright.live.config.ts",
    "clean": "node scripts/clean.mjs"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "13.1.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@testcontainers/postgresql": "12.2.1",
    "@types/connect-pg-simple": "7.0.3",
    "@types/express": "5.0.6",
    "@types/express-session": "1.19.0",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.14.0",
    "fast-check": "4.10.2",
    "lighthouse": "13.6.0",
    "prettier": "3.9.10",
    "supertest": "7.3.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  },
  "overrides": {
    "minimatch": "11.0.4"
  }
}
